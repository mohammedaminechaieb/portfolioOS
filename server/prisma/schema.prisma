generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// MAPPED TO OLD COLLECTIONS (with data)
// ═══════════════════════════════════════════════════════════════

// Old: users (1 doc) — username:"admin", password, role:"admin"
// New admin doc will coexist (different _id)
model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique @map("username")
  password  String
  name      String   @map("role")
  createdAt DateTime @default(now())
  @@map("users")
}

// Old: settings (1 doc) — siteName, avatar, tagline, bio, socialLinks{...}, theme{...}
// New Profile doc (_id:"main") coexists alongside old ObjectId doc
// Prisma ignores nested socialLinks/theme — they stay for old portfolio
model Profile {
  id        String   @id @map("_id")
  name      String   @default("Mohamed Amine Chaieb")
  title     String   @default("Full-Stack Developer")
  subtitle  String   @default("Computer Engineering Student at ENSI") @map("tagline")
  bio       String   @default("")
  email     String   @default("m.amine.chaieb@gmail.com")
  phone     String   @default("+216 29 663 667")
  location  String   @default("Tunisia")
  github    String   @default("https://github.com/mohammedaminechaieb")
  linkedin  String   @default("https://linkedin.com/in/mohammedaminechaieb")
  portfolio String   @default("")
  avatarUrl String   @default("") @map("avatar")
  resumeUrl String   @default("")
  available Boolean  @default(true)
  updatedAt DateTime @updatedAt
  @@map("settings")
}

// Old: projects (18 docs) — technologies[], image, no slug, no category
model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String?
  description String
  longDesc    String?
  techStack   String[] @map("technologies")
  category    String?  @default("other")
  imageUrl    String?  @map("image")
  liveUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  @@map("projects")
}

// Old: skills (45 docs) — PERFECT MATCH, no renames needed
model Skill {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  category String
  level    Int     @default(70)
  icon     String?
  order    Int     @default(0)
  @@map("skills")
}

// Old: events (5 docs) — type→organizer, achievement→result, date is BSON Date
model Competition {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  organizer   String?   @map("type")
  date        DateTime?
  result      String?   @map("achievement")
  description String?
  image       String?
  order       Int       @default(0)
  @@map("events")
}

// Old: certificates (8 docs) — credentialUrl→url, date is BSON Date
model Certification {
  id     String    @id @default(auto()) @map("_id") @db.ObjectId
  title  String
  issuer String
  date   DateTime?
  url      String?   @map("credentialUrl")
  image    String?
  category String?
  order    Int       @default(0)
  @@map("certificates")
}

// Old: contacts (0 docs) — message→body
model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  body      String   @map("message")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@map("contacts")
}

// ═══════════════════════════════════════════════════════════════
// NEW COLLECTIONS (no old equivalent)
// ═══════════════════════════════════════════════════════════════

model Experience {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  role        String
  company     String
  companyUrl  String?
  location    String
  type        String
  startDate   String
  endDate     String?
  current     Boolean  @default(false)
  description String
  highlights  String[]
  techStack   String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  degree      String
  school      String
  schoolUrl   String?
  location    String
  startDate   String
  endDate     String?
  current     Boolean @default(false)
  description String?
  gpa         String?
  order       Int     @default(0)
}

model SiteConfig {
  id               String  @id @map("_id")
  osName           String  @default("AmineOS")
  osVersion        String  @default("3.0")
  bootText         String?
  terminalGreeting String?
  deskWallpaper    String  @default("wood-dark")
  osWallpaper      String  @default("gradient-teal")
  accentColor      String  @default("#0ea5e9")
  enableDesk       Boolean @default(true)
  enableOs         Boolean @default(true)
  defaultMode      String  @default("desk")
  metaTitle        String  @default("Mohamed Amine Chaieb // Portfolio")
  metaDescription  String  @default("Computer Engineering student & Full-Stack Developer")
}

// ═══════════════════════════════════════════════════════════════
// OLD COLLECTIONS THE APP DID NOT READ BEFORE
// ═══════════════════════════════════════════════════════════════

// Old: clubs (5 docs)
model Club {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  role         String?
  description  String?
  period       String?
  image        String?
  achievements String[]
  order        Int      @default(0)
  @@map("clubs")
}

// Old: designs (13 docs) — graphic design work
model Design {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  category    String?
  image       String?
  tools       String[]
  order       Int      @default(0)
  @@map("designs")
}
