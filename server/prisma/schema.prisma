generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Profile {
  id        String  @id @map("_id")
  name      String  @default("Mohamed Amine Chaieb")
  title     String  @default("Full-Stack Developer")
  subtitle  String  @default("Computer Engineering Student at ENSI")
  bio       String
  email     String  @default("m.amine.chaieb@gmail.com")
  phone     String  @default("+216 29 663 667")
  location  String  @default("Tunisia")
  github    String  @default("https://github.com/mohammedaminechaieb")
  linkedin  String  @default("https://linkedin.com/in/mohammedaminechaieb")
  portfolio String  @default("")
  avatarUrl String  @default("")
  resumeUrl String  @default("")
  available Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  description String
  longDesc    String?
  techStack   String[]
  category    String
  imageUrl    String?
  liveUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  role        String
  company     String
  companyUrl  String?
  location    String
  type        String
  startDate   String
  endDate     String?
  current     Boolean  @default(false)
  description String
  highlights  String[]
  techStack   String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  category String
  level    Int     @default(70)
  icon     String?
  order    Int     @default(0)
}

model Education {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  degree      String
  school      String
  schoolUrl   String?
  location    String
  startDate   String
  endDate     String?
  current     Boolean @default(false)
  description String?
  gpa         String?
  order       Int     @default(0)
}

model Competition {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  organizer   String?
  date        String
  result      String?
  description String?
  order       Int     @default(0)
}

model Certification {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  title  String
  issuer String
  date   String
  url    String?
  order  Int     @default(0)
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteConfig {
  id               String  @id @map("_id")
  osName           String  @default("AmineOS")
  osVersion        String  @default("3.0")
  bootText         String?
  terminalGreeting String?
  deskWallpaper    String  @default("wood-dark")
  osWallpaper      String  @default("gradient-teal")
  accentColor      String  @default("#0ea5e9")
  enableDesk       Boolean @default(true)
  enableOs         Boolean @default(true)
  defaultMode      String  @default("desk")
  metaTitle        String  @default("Mohamed Amine Chaieb // Portfolio")
  metaDescription  String  @default("Computer Engineering student & Full-Stack Developer")
}
