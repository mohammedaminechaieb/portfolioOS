# ══════════════════════════════════
#  Portfolio — Environment Variables
# ══════════════════════════════════

# ── MongoDB ──
# Your MongoDB connection string (Atlas or self-hosted)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority"

# ── Auth ──
JWT_SECRET="change-me-to-a-random-secret"

# ── Server ──
PORT=4000
NODE_ENV=production

# ── CORS ──
# Frontend URL (no trailing slash)
CLIENT_URL="https://your-frontend.onrender.com"

# ── Client (.env.local in /client) ──
# NEXT_PUBLIC_API_URL="https://your-api.onrender.com"
